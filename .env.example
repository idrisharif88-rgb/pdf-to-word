# Copy this file to .env and adjust. .env is git-ignored.

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=eu
GCP_PROCESSOR_ID=your-ocr-processor-id

# Auth option A: path to a service-account JSON key copied from the old machine.
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Auth option B (recommended): leave the line above commented out and run
#   gcloud auth application-default login
# The client then picks up Application Default Credentials automatically.

# --- v2.0 typography and layout (all optional) ---
#ARABIC_FONT=Aref Ruqaa
#LATIN_FONT=Times New Roman
#ARABIC_SIZE_PT=18
#ARABIC_BOLD=1
#LINE_SPACING=1.6
#PAGE_MARGIN_CM=2.5
#MIRROR_MARGINS=1
#KEEP_LINE_BREAKS=0
#ADD_TOC=1
#EXTRACT_TABLES=1

# Tables need a Form Parser processor; a Document OCR processor returns none.
#GCP_FORM_PROCESSOR_ID=
#EXACT_LAYOUT=0
#EXTRACT_IMAGES=1
#HEADING_RATIO_1=1.5
#HEADING_RATIO_2=1.25
#FOOTNOTE_BAND=0.78
#DROP_RUNNING_HEADS=1
#IMAGE_PAGES=1-6,140-146
#IMAGE_FALLBACK_CHARS=40
#PAGE_IMAGE_DPI=150
